<!-- HARDWARE - the bargain GPUs -->
<section data-background-color="#0c1a2a">
    <h2>💾 The Bargain Bin (VRAM per Dollar)</h2>
    <table>
        <thead>
            <tr><th>GPU</th><th>VRAM</th><th>The Catch</th></tr>
        </thead>
        <tbody>
            <tr><td>🟩 Tesla M40</td><td>24 GB</td><td>Ancient Maxwell, no fan, needs a blower + cooling hack 🌬️</td></tr>
            <tr><td>🟥 AMD MI50</td><td>32 GB</td><td>HBM2 monster, ROCm setup is a rite of passage 🧙</td></tr>
            <tr><td>🟥 RX 7700 XT / 6900 XT</td><td>~16 GB</td><td>Gaming card, ROCm/Vulkan, great value 🎮</td></tr>
